#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

declare -a native_candidates=()
if [[ -n "${SIGNAL_LIGHT_NATIVE_BIN:-}" ]]; then
  native_candidates+=("${SIGNAL_LIGHT_NATIVE_BIN}")
fi
native_candidates+=(
  "$ROOT_DIR/native/target/release/signal-light-native"
  "$ROOT_DIR/native/target/debug/signal-light-native"
)
for candidate in "${native_candidates[@]}"; do
  if [[ -x "$candidate" ]]; then
    exec "$candidate" install-hooks "$@"
  fi
done

{
  echo "signal-light-native binary not found."
  echo "Build it with: cargo build --manifest-path native/Cargo.toml --release"
  echo "Or set SIGNAL_LIGHT_NATIVE_BIN=/absolute/path/to/signal-light-native"
} >&2
exit 127
